{
  "name": "xtra-cash",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.18.0",
  "pnpm": {
    "overrides": {
      "postcss": "8.5.23",
      "source-map-js": "1.2.2",
      "sharp": "0.35.5",
      "shell-quote": "1.11.0",
      "body-parser": "2.4.0",
      "qs": "6.16.1",
      "undici@6": "6.29.1",
      "undici@7": "7.30.1",
      "node-forge": "1.4.1",
      "multer": "2.5.0",
      "js-yaml@5": "5.4.1"
    }
  },
  "scripts": {
    "build:shared": "pnpm --filter @xtra/shared build",
    "dev:api": "pnpm --filter @xtra/api dev",
    "dev:web": "pnpm --filter @xtra/web dev",
    "dev:admin": "pnpm --filter @xtra/admin dev",
    "dev:mobile": "pnpm --filter @xtra/mobile start",
    "dev:payday": "pnpm --filter @xtra/payday start",
    "db:migrate": "pnpm --filter @xtra/api db:migrate",
    "db:seed": "pnpm --filter @xtra/api seed",
    "test": "pnpm --filter @xtra/api test",
    "typecheck": "pnpm -r typecheck"
  }
}
