DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xtracash
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
# Shared secret used by the card processor to sign authorisation webhooks (HMAC-SHA256)
CARD_NETWORK_SECRET=change-me
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081
# Allows the demo "simulate purchase" and mock top-up endpoints. Disable in production.
ENABLE_SIMULATION=true
PUBLIC_URL=http://localhost:4000
# One-click demo accounts on the web and back-office sign-in pages (on unless set to false). Set to false before real customers sign up.
ENABLE_DEMO_LOGIN=true
