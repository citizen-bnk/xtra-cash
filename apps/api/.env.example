DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xtracash
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
# Shared secret used by the card processor to sign authorisation webhooks (HMAC-SHA256)
CARD_NETWORK_SECRET=change-me
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081
# Allows the demo "simulate purchase" and mock top-up endpoints. Disable in production.
ENABLE_SIMULATION=true
PUBLIC_URL=http://localhost:4000
# One-click demo accounts on the web and back-office sign-in pages (on unless set to false). Set to false before real customers sign up.
ENABLE_DEMO_LOGIN=true

# Personal lending workflow. These gates remain off until lender/legal/bank approval.
PERSONAL_AGREEMENTS_ENABLED=false
MONEY_PROGRAMME_ENABLED=false
# Provision the selected bank-approved bridge; see docs/PERSONAL-LOANS-ACTIVATION.md.
MONEY_CONNECTOR_URL=
MONEY_CONNECTOR_TOKEN=
MONEY_WEBHOOK_SECRET=
MONEY_PROGRAMME_REFERENCE=
MONEY_DAILY_LIMIT_CENTS=1000000
# Set through a controlled key migration if existing records use JWT_SECRET fallback.
# IDENTITY_ENCRYPTION_KEY=
