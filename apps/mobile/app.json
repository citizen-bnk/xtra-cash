{
  "expo": {
    "name": "XTRA-CASH",
    "slug": "xtra-cash-fintech",
    "scheme": "xtracash",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "za.co.xtracash.app",
      "supportsTablet": false
    },
    "android": {
      "package": "za.co.xtracash.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Use your location to find nearby XTRA-CASH offers when you opt in.",
          "locationAlwaysAndWhenInUsePermission": "With your permission, detect arrival near offer locations while XTRA-CASH is closed.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "xtra-cash-team",
    "extra": {
      "eas": {
        "projectId": "417255b5-4f68-4dc1-8614-7f1ac5ddd8fc"
      }
    }
  }
}
