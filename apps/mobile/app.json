{
  "expo": {
    "name": "XTRA-CASH",
    "slug": "xtra-cash",
    "scheme": "xtracash",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": { "bundleIdentifier": "za.co.xtracash.app", "supportsTablet": false },
    "android": { "package": "za.co.xtracash.app", "edgeToEdgeEnabled": true },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": { "typedRoutes": false }
  }
}
